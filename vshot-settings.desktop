[Desktop Entry]
# The launcher entry for the settings window.  It is a separate file from
# vshot.desktop on purpose: that one exists only to carry KWin's D-Bus
# authorization, has to keep Exec= pointing at the bare binary, and is
# NoDisplay=true because running `vshot` with no subcommand just reports that
# no output destination was given.
#
# This one is what a desktop's application menu shows.  Exec= still names the
# packaged binary first, so it grants the same ScreenShot2 authorization by
# accident; that is harmless, because the settings window captures nothing.
Type=Application
Name=VShot Settings
Name[zh_CN]=VShot 设置
Comment=Edit the annotation editor's style and the command-line defaults
Comment[zh_CN]=修改标注编辑器样式与命令行默认值
Exec=/usr/bin/vshot settings
Icon=vshot
Terminal=false
Categories=Settings;
Keywords=screenshot;capture;annotation;config;settings;
Keywords[zh_CN]=截图;标注;配置;设置;
StartupNotify=true
